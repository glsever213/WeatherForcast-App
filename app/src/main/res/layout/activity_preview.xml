<?xml version="1.0" encoding="utf-8"?>
<!--
    PreviewActivity layout — 3 vùng từ trên xuống:
    1. Header: nút back + tên thành phố + hero thời tiết (nhiệt độ, điều kiện, icon)
    2. Khối "Hôm nay" (RecyclerView theo giờ) với BlurTarget nền + BlurView glass card
    3. Footer: ExtendedFAB "Thêm vào trang home" đúng Material FAB behavior
       (icon + label cùng hàng, không tách FAB riêng với TextView bên dưới)

    Loading state: ProgressBar overlay hiển thị trong khi gọi API; ẩn đi sau khi có data.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg_black"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ═══════════════════ HEADER ═══════════════════ -->

    <ImageButton
        android:id="@+id/buttonBackPreview"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cancel"
        android:src="@drawable/ic_back_24" />

    <!--
        Hero block: tên thành phố + nhiệt độ lớn + điều kiện + icon thời tiết.
        Sắp xếp: hàng ngang — [cột chữ (tên + °C + điều kiện)] [icon bên phải]
        Visibility INVISIBLE khi đang load (giữ chỗ), VISIBLE sau khi có data.
        Dùng INVISIBLE thay GONE để layout không bị giật khi data đến.
    -->
    <LinearLayout
        android:id="@+id/layoutPreviewHero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp"
        android:visibility="invisible">

        <!-- Cột trái: tên thành phố + nhiệt độ + điều kiện -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textPreviewCity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary_on_dark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Nhiệt độ lớn — điền từ current.temp_c -->
            <TextView
                android:id="@+id/textPreviewTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary_on_dark"
                android:textSize="56sp"
                android:textStyle="bold"
                android:lineSpacingExtra="-4dp" />

            <!-- Mô tả điều kiện thời tiết — điền từ current.condition.text -->
            <TextView
                android:id="@+id/textPreviewCondition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary_on_dark"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Icon thời tiết bên phải — load từ condition.icon qua Glide -->
        <ImageView
            android:id="@+id/imagePreviewWeatherIcon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_weather_placeholder" />
    </LinearLayout>

    <!-- ═══════════════════ KHỐI "HÔM NAY" (hourly) ═══════════════════ -->
    <!--
        FrameLayout chứa:
        - BlurTarget (nền đen tạo bề mặt cho blur)
        - widget_today_hourly_block (BlurView + card glass + RecyclerView ngang)
        - ProgressBar: hiện khi đang gọi API, ẩn khi có data / lỗi
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp">

        <eightbitlab.com.blurview.BlurTarget
            android:id="@+id/blurTargetRoot"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/screen_bg_black" />
        </eightbitlab.com.blurview.BlurTarget>

        <include
            android:id="@+id/blockTodayHourlyPreview"
            layout="@layout/widget_today_hourly_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top" />

        <!--
            Loading indicator: hiện khi gọi API, ẩn (GONE) sau khi hoàn thành.
            Dùng GONE để không chiếm không gian khi không cần thiết.
        -->
        <ProgressBar
            android:id="@+id/progressPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ═══════════════════ FOOTER: FAB ═══════════════════ -->
    <!--
        ExtendedFAB = FAB đúng Material Design 3 behavior: icon + label text cùng hàng
        trong một component, không cần tách FAB + TextView riêng như cũ.

        Khi địa điểm ĐÃ được lưu:
        - Icon chuyển sang ic_check (hoặc tương đương) và text đổi thành "Đã lưu"
        - FAB disabled (không bấm được nữa) — tránh thêm trùng

        Hai trạng thái này được xử lý trong PreviewActivity.java.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="20dp">

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabAddToHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_to_home"
            android:textColor="@color/text_primary_on_dark"
            app:backgroundTint="#8899AABB"
            app:icon="@drawable/ic_add_24"
            app:iconTint="@color/text_primary_on_dark" />
    </LinearLayout>

</LinearLayout>
