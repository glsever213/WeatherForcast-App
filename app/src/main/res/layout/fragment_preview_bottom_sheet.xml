<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/screen_bg_black"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:background="@color/glass_stroke_on_dark"
        android:backgroundTint="@color/text_secondary_on_dark"
        android:layout_marginStart="0dp" />

    <LinearLayout
        android:id="@+id/layoutPreviewHero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textPreviewCity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary_on_dark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textPreviewTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary_on_dark"
                android:textSize="56sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textPreviewCondition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary_on_dark"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imagePreviewWeatherIcon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_weather_placeholder" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp">

        <eightbitlab.com.blurview.BlurTarget
            android:id="@+id/blurTargetRoot"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/screen_bg_black" />
        </eightbitlab.com.blurview.BlurTarget>

        <include
            android:id="@+id/blockTodayHourlyPreview"
            layout="@layout/widget_today_hourly_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top" />

        <ProgressBar
            android:id="@+id/progressPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="20dp">

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabViewDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preview_add"
            android:textColor="@color/text_primary_on_dark"
            app:backgroundTint="#8899AABB" />
    </LinearLayout>

</LinearLayout>