<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    app:cardBackgroundColor="@color/glass_surface_soft"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/glass_stroke"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:minWidth="72dp"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/textHourlyTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary_on_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="29°" />

        <ImageView
            android:id="@+id/iconHourly"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:contentDescription="@null"
            tools:src="@drawable/ic_weather_placeholder" />

        <TextView
            android:id="@+id/textHourlyTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_primary_on_dark"
            android:textSize="13sp"
            tools:text="17:00" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
